# --- Python / tooling
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.DS_Store

# --- Secrets: never commit. Use .env.example as the template.
.env
.env.*
!.env.example
*.pem
*.key

# --- Data: reproducible from public sources (scripts/bootstrap.sh); kept local, never on GitHub
data/raw/
data/db/
data/tmp/
*.duckdb
*.duckdb.wal
*.duckdb.building-*

# --- Runtime state: conversations, model usage logs, caches
data/app/
*.log
*.sqlite
*.sqlite-shm
*.sqlite-wal

# --- Generated evaluation artefacts (score reports are kept; transcripts and pickles are not)
eval/runs/**/session.pkl*
eval/runs/**/agent_stdout.txt
*.pkl
eval/runs/gemini_smoke/
eval/runs/groq_smoke/
eval/runs/link_audit.json
