# Copy to .env (git-ignored). Variables already set in the shell take precedence over this file.

# ---- Planner mode -----------------------------------------------------------------
# offline (default): deterministic rule-based planner, NO model API calls, no key needed.
# gemini           : Google Gemini function calling. Requires all three lines below.
AIRPORT_MODEL=offline
# AIRPORT_MODEL=gemini
# AIRPORT_ALLOW_GEMINI=1
# GEMINI_API_KEY=your-key-here

# Free-tier Flash model ids only (anything else needs AIRPORT_ALLOW_PAID=1, which you should not set).
# AIRPORT_GEMINI_MODEL=gemini-3.8-flash
# Application-level cap on Gemini requests per UTC day, persisted in data/app/gemini_usage.jsonl.
# AIRPORT_GEMINI_MAX_REQUESTS=25

# ---- Optional ------------------------------------------------------------------------
# AIRPORT_WEB=0              # disable web research (only offered to LLM planners)
# AIRPORT_DATA_DIR=/path     # use a data directory elsewhere (raw/, db/, app/ ...)
